PORT=4000

# The deployed client URL, used for CORS + Socket.io. Keep as localhost for
# local dev; set to your Vercel URL (e.g. https://listen-together.vercel.app)
# once deployed.
CLIENT_ORIGIN=http://localhost:5173

# Register a free app at https://developer.spotify.com/dashboard to get these.
# Used for both the server-side Client Credentials flow (catalog search) and
# the per-host Authorization Code flow (real queueing - see below).
SPOTIFY_CLIENT_ID=YOUR_SPOTIFY_CLIENT_ID_HERE
SPOTIFY_CLIENT_SECRET=YOUR_SPOTIFY_CLIENT_SECRET_HERE

# Lets the room host connect their own Spotify account so "Add to queue" also
# pushes the track onto their real Spotify player (requires Premium + an
# active playback session). Must exactly match a "Redirect URI" you add in
# your Spotify app's dashboard settings (Settings > Redirect URIs):
#   - Local dev:  http://127.0.0.1:4000/api/spotify/callback
#     (Spotify no longer allows plain "localhost" - use the 127.0.0.1 literal)
#   - Production: https://<your-render-service>.onrender.com/api/spotify/callback
#     (must be HTTPS - Render provides this automatically)
# Leave unset to skip this feature entirely; search/queueing in-app still works.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:4000/api/spotify/callback

# Optional: enables a TURN server fallback so WebRTC audio sharing works
# reliably across stricter NATs/firewalls (not just STUN). Sign up free at
# https://openrelayproject.org or https://www.metered.ca/stun-turn, then set
# both the API key and the domain shown on your dashboard
# (e.g. METERED_DOMAIN=yourapp.metered.live). Leave blank to use STUN only.
METERED_API_KEY=
METERED_DOMAIN=
