PORT=4000

# The deployed client URL, used for CORS + Socket.io. Keep as localhost for
# local dev; set to your Vercel URL (e.g. https://listen-together.vercel.app)
# once deployed.
CLIENT_ORIGIN=http://localhost:5173

# Register a free app at https://developer.spotify.com/dashboard to get these.
# Used only for the server-side Client Credentials flow (catalog search) -
# no user login/OAuth is required.
SPOTIFY_CLIENT_ID=YOUR_SPOTIFY_CLIENT_ID_HERE
SPOTIFY_CLIENT_SECRET=YOUR_SPOTIFY_CLIENT_SECRET_HERE

# Optional: enables a TURN server fallback so WebRTC audio sharing works
# reliably across stricter NATs/firewalls (not just STUN). Sign up free at
# https://openrelayproject.org or https://www.metered.ca/stun-turn, then set
# both the API key and the domain shown on your dashboard
# (e.g. METERED_DOMAIN=yourapp.metered.live). Leave blank to use STUN only.
METERED_API_KEY=
METERED_DOMAIN=
